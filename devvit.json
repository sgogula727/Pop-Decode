{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "pop-decode",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Pop Decode Round",
        "description": "Create a new movie or song guessing post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-round"
      }
    ]
  },
  "forms": {
    "createRoundForm": "/internal/form/create-round-submit"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "pop_decode_dev"
  }
}
